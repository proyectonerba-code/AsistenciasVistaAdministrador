# ============================================================
# Control de Asistencia — Vista Administrador
# Copia este archivo a .env.local y configura las variables.
# Nunca subas .env.local al repositorio.
# ============================================================

# --- Supabase (mismo proyecto que el backend) ---
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_publica

# Service role (SOLO servidor del admin)
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key

# --- Modo demostración (opcional) ---
# Con SUPABASE_DEMO=1 se usa un cliente Supabase simulado en memoria.
# NO lo actives en producción.
SUPABASE_DEMO=0

# --- Otros ---
# Secreto para firmar/validar sesión propia (si no se usan cookies de Supabase)
SESSION_SECRET=cambia_este_secreto_aleatorio

# Dominio de la vista de registro (para mostrar la URL /c/<token>)
NEXT_PUBLIC_REGISTRO_URL=https://registro.nerwork.mx

# Correo admin para avisos
ADMIN_ALERT_EMAIL=admin@tuempresa.mx

# Zona horaria del sistema
TZ=America/Mexico_City
